        <item name="zfMuted">#475973</item>
        <item name="zfAccent">#195D6E</item>
        <item name="zfAccentInk">#FFFFFF</item>
        <item name="zfGlassEdge">#5A6484A8</item>
        <item name="zfGlassFill">#EAF5FCFF</item>
        <item name="zfBad">#9B2C13</item>
        <item name="zfOk">#126244</item>
        <item name="colorPrimary">?attr/zfAccent</item>
        <item name="colorOnPrimary">?attr/zfAccentInk</item>
        <item name="colorSurface">?attr/zfSurface</item>
        <item name="colorOnSurface">?attr/zfText</item>
