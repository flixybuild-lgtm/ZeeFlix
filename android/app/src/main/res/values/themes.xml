    <style name="Theme.ZeeFlix.Matrix" parent="Theme.Material3.Dark.NoActionBar">
        <item name="zfBackground">#030B07</item>
        <item name="zfSurface">#09170E</item>
        <item name="zfText">#E6FFF0</item>
