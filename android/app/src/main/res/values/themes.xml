<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZeeFlix" parent="Theme.Material3.Dark.NoActionBar">
        <item name="zfBackground">@color/zf_bg</item>
        <item name="zfSurface">@color/zf_surface</item>
        <item name="zfText">@color/zf_text</item>
        <item name="zfMuted">@color/zf_muted</item>
        <item name="zfAccent">@color/zf_accent</item>
