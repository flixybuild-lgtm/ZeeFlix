<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/inputProviderName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="Title (e.g. My Movie)"
            android:inputType="text"
            android:textColor="?attr/zfText"
            android:textColorHint="?attr/zfMuted" />

        <Spinner
            android:id="@+id/spinnerProviderFormat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/inputProviderUrl"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:hint="https://… (MP4, WebM, HLS, DASH, or Embed)"
            android:inputType="textUri"
            android:textColor="?attr/zfText"
            android:textColorHint="?attr/zfMuted" />

        <CheckBox
            android:id="@+id/checkProviderDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Allow downloads (direct MP4/WebM only)"
            android:textColor="?attr/zfText" />

        <CheckBox
            android:id="@+id/checkProviderRights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I have permission to stream this media."
            android:textColor="?attr/zfText" />

        <TextView
            android:id="@+id/textProviderError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/zfBad"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
