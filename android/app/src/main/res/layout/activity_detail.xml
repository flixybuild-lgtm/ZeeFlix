<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zfBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="?attr/zfSurface"
            app:cardCornerRadius="16dp">

            <ImageView
                android:id="@+id/detailArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Artwork"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?attr/zfText"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/zfAccent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/zfMuted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailWatch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Watch Now"
                android:textColor="?attr/zfAccentInk"
                app:backgroundTint="?attr/zfAccent"
                app:icon="@drawable/ic_play"
                app:iconTint="?attr/zfAccentInk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailList"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:text="My List"
                android:textColor="?attr/zfText"
                app:strokeColor="?attr/zfGlassEdge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailFav"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Fav"
                android:textColor="?attr/zfText"
                app:strokeColor="?attr/zfGlassEdge" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailFacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_card"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:textColor="?attr/zfText"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/detailEpisodesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
